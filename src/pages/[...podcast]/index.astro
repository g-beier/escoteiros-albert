---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import PlayEpisodeButton from '~/components/podcast/PlayEpisodeButton.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { getStaticPathsPodcastEpisode, podcastEpisodeRobots } from '~/utils/podcast';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';
import type { MetaData } from '~/types';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsPodcastEpisode();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { episode } = Astro.props as Props;

const url = getCanonical(getPermalink(episode.permalink, 'episode'));
const image = (await findImage(episode.image)) as ImageMetadata | string | undefined;

const metadata = merge(
  {
    title: episode.title,
    description: episode.summary,
    robots: {
      index: podcastEpisodeRobots?.index,
      follow: podcastEpisodeRobots?.follow,
    },
    openGraph: {
      type: 'article',
      ...(image
        ? { images: [{ url: image, width: (image as ImageMetadata)?.width, height: (image as ImageMetadata)?.height }] }
        : {}),
    },
  },
  { ...(episode?.metadata ? { ...episode.metadata, canonical: episode.metadata?.canonical || url } : {}) }
) as MetaData;
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-4xl px-6 py-12 sm:px-6 sm:py-16 lg:py-20">
    <p class="mb-2 text-sm font-semibold text-primary">Episódio {episode.episode}</p>
    <h1 class="text-4xl font-bold leading-tight tracking-tight md:text-5xl">{episode.title}</h1>
    <p class="mt-4 text-sm text-gray-500 dark:text-slate-400">
      {getFormattedDate(episode.published)}
      {episode.duration && <> · {episode.duration}</>}
    </p>

    <PlayEpisodeButton episode={episode} class="mt-8" />

    {
      episode.Content && (
        <div class="prose prose-slate mx-auto mt-10 max-w-none dark:prose-invert">
          <episode.Content />
        </div>
      )
    }
  </section>
</Layout>
