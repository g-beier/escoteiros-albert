---
import { getPostPermalink } from '~/utils/permalinks';

// true: contagem mostra só os dias ("12 dias", "Amanhã", "Hoje!"); false: dias + hh:mm:ss
const somenteDias = true;
---

<div
  id="announcement"
  class="text-muted relative hidden gap-1 truncate border-b border-yellow-300 bg-yellow-300/40 px-3 py-2 text-sm whitespace-nowrap"
>
  <span class="mr-0.5 inline-block bg-yellow-400 px-1 py-0.5 text-xs font-bold text-yellow-50 rtl:mr-0 rtl:ml-0.5">
    12/dez
  </span>
  <span
    id="timer"
    data-somente-dias={somenteDias ? 'true' : undefined}
    class="mx-2 font-mono font-semibold tabular-nums"></span>
  <a
    href={getPostPermalink('edital-assembleia-2026')}
    class="font-medium text-ellipsis text-yellow-800 hover:underline"
  >
    Assembleia de Grupo<span class="hidden md:inline">: confira o edital e as pautas! »</span>
  </a>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Início da assembleia (contagem regressiva) e fim da exibição do aviso, no horário de Brasília
    const dataEvento = new Date('2026-12-12T14:00:00-03:00');
    const dataLimite = new Date('2026-12-13T00:00:00-03:00');
    const announcement = document.getElementById('announcement');

    if (new Date() < dataLimite && announcement) {
      announcement.classList.remove('hidden');
      announcement.classList.add('flex');
    }

    const DIA = 1000 * 60 * 60 * 24;
    const BRASILIA = -3 * 60 * 60 * 1000;
    const pad = (n: number) => n.toString().padStart(2, '0');
    const plural = (n: number) => `${n} ${n === 1 ? 'dia' : 'dias'}`;

    // Diferença em dias de calendário (horário de Brasília), não em blocos de 24h
    const diasAteEvento = () =>
      Math.floor((dataEvento.getTime() + BRASILIA) / DIA) - Math.floor((Date.now() + BRASILIA) / DIA);

    const atualizar = () => {
      const timer = document.getElementById('timer');
      if (!timer) {
        clearInterval(x);
        return;
      }

      const distance = dataEvento.getTime() - Date.now();

      if (timer.dataset.somenteDias) {
        const dias = diasAteEvento();
        timer.textContent = dias <= 0 ? 'Hoje!' : dias === 1 ? 'Amanhã' : plural(dias);
        if (distance <= 0) clearInterval(x);
        return;
      }

      if (distance <= 0) {
        timer.textContent = 'Hoje!';
        clearInterval(x);
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      let time = '';
      if (days) {
        time += `${plural(days)} `;
      }
      time += `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;

      timer.textContent = time;
    };

    const x = setInterval(atualizar, 1000);
    atualizar();
  });
</script>
