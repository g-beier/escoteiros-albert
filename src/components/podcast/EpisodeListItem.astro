---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Episode } from '~/types';
import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  episode: Episode;
}

const { episode } = Astro.props;
const link = getPermalink(episode.permalink, 'episode');
const image = (await findImage(episode.image)) as ImageMetadata | undefined;
---

<a href={link} class="flex items-center gap-4 rounded-lg p-3 transition-colors hover:bg-gray-50 dark:hover:bg-slate-800">
  {
    image && (
      <Image src={image} alt={episode.title} width={64} height={64} class="h-16 w-16 shrink-0 rounded-md object-cover" />
    )
  }
  <div class="min-w-0">
    <p class="text-xs font-semibold text-primary">Episódio {episode.episode}</p>
    <h3 class="truncate text-lg font-semibold text-gray-900 dark:text-white">{episode.title}</h3>
    <p class="text-sm text-gray-500 dark:text-slate-400">
      {getFormattedDate(episode.published)}
      {episode.duration && <> · {episode.duration}</>}
    </p>
  </div>
</a>
