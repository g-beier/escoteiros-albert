---
// Persistent mini-player. Stays mounted across page navigations via `transition:persist`
// so playback survives site navigation. Never autoplays — only starts when an episode
// page dispatches a `podcast:play` event from a user click.
---

<div
  id="podcast-player"
  transition:persist
  class="fixed inset-x-0 bottom-0 z-50 hidden translate-y-full border-t border-gray-200 bg-white/95 backdrop-blur transition-transform duration-300 dark:border-slate-700 dark:bg-slate-900/95"
>
  <div class="mx-auto flex max-w-4xl items-center gap-4 px-4 py-3 sm:px-6">
    <button
      id="podcast-player-toggle"
      type="button"
      aria-label="Tocar/Pausar"
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-white"
    >
      <svg id="podcast-player-icon-play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5 fill-current">
        <path d="M8 5v14l11-7z"></path>
      </svg>
      <svg
        id="podcast-player-icon-pause"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        class="hidden h-5 w-5 fill-current"
      >
        <path d="M6 5h4v14H6zM14 5h4v14h-4z"></path>
      </svg>
    </button>

    <div class="min-w-0 flex-1">
      <p id="podcast-player-title" class="truncate text-sm font-semibold text-gray-900 dark:text-white">&nbsp;</p>
      <div class="mt-1 flex items-center gap-2">
        <span id="podcast-player-current" class="w-10 shrink-0 text-xs tabular-nums text-gray-500 dark:text-slate-400"
          >0:00</span
        >
        <input
          id="podcast-player-seek"
          type="range"
          min="0"
          max="100"
          value="0"
          step="0.1"
          class="h-1 w-full cursor-pointer accent-primary"
        />
        <span id="podcast-player-duration" class="w-10 shrink-0 text-xs tabular-nums text-gray-500 dark:text-slate-400"
          >0:00</span
        >
      </div>
    </div>

    <button
      id="podcast-player-close"
      type="button"
      aria-label="Fechar player"
      class="shrink-0 text-gray-400 hover:text-gray-600 dark:hover:text-slate-200"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5 fill-current">
        <path
          d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
        ></path>
      </svg>
    </button>

    <audio id="podcast-player-audio"></audio>
  </div>
</div>

<script>
  type PlayEpisodeDetail = { src: string; title: string; slug: string };

  const player = document.getElementById('podcast-player') as HTMLDivElement;
  const audio = document.getElementById('podcast-player-audio') as HTMLAudioElement;
  const toggleBtn = document.getElementById('podcast-player-toggle') as HTMLButtonElement;
  const closeBtn = document.getElementById('podcast-player-close') as HTMLButtonElement;
  const iconPlay = document.getElementById('podcast-player-icon-play') as unknown as SVGElement;
  const iconPause = document.getElementById('podcast-player-icon-pause') as unknown as SVGElement;
  const titleEl = document.getElementById('podcast-player-title') as HTMLParagraphElement;
  const seekEl = document.getElementById('podcast-player-seek') as HTMLInputElement;
  const currentEl = document.getElementById('podcast-player-current') as HTMLSpanElement;
  const durationEl = document.getElementById('podcast-player-duration') as HTMLSpanElement;

  let currentSlug: string | null = null;
  let isSeeking = false;

  const formatTime = (seconds: number): string => {
    if (!Number.isFinite(seconds)) return '0:00';
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60)
      .toString()
      .padStart(2, '0');
    return `${m}:${s}`;
  };

  const showPlayer = () => {
    player.classList.remove('hidden');
    requestAnimationFrame(() => player.classList.remove('translate-y-full'));
  };

  const setPlayingUI = (playing: boolean) => {
    iconPlay.classList.toggle('hidden', playing);
    iconPause.classList.toggle('hidden', !playing);
  };

  const playEpisode = (detail: PlayEpisodeDetail) => {
    showPlayer();
    titleEl.textContent = detail.title;

    if (currentSlug !== detail.slug) {
      currentSlug = detail.slug;
      audio.src = detail.src;
    }

    audio.play();
  };

  window.addEventListener('podcast:play', ((event: CustomEvent<PlayEpisodeDetail>) => {
    playEpisode(event.detail);
  }) as EventListener);

  toggleBtn.addEventListener('click', () => {
    if (!audio.src) return;
    if (audio.paused) audio.play();
    else audio.pause();
  });

  closeBtn.addEventListener('click', () => {
    audio.pause();
    audio.removeAttribute('src');
    currentSlug = null;
    player.classList.add('translate-y-full');
    setTimeout(() => player.classList.add('hidden'), 300);
  });

  audio.addEventListener('play', () => setPlayingUI(true));
  audio.addEventListener('pause', () => setPlayingUI(false));

  audio.addEventListener('loadedmetadata', () => {
    seekEl.max = String(audio.duration || 0);
    durationEl.textContent = formatTime(audio.duration);
  });

  audio.addEventListener('timeupdate', () => {
    if (isSeeking) return;
    seekEl.value = String(audio.currentTime);
    currentEl.textContent = formatTime(audio.currentTime);
  });

  seekEl.addEventListener('input', () => {
    isSeeking = true;
    currentEl.textContent = formatTime(Number(seekEl.value));
  });

  seekEl.addEventListener('change', () => {
    audio.currentTime = Number(seekEl.value);
    isSeeking = false;
  });
</script>
