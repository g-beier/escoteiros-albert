{
  "name": "geas-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:institucional": "npm run dev --workspace=@geas/institucional",
    "dev:financeiro": "npm run dev --workspace=@geas/financeiro",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && npm run lint:eslint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "infra:start": "npm run infra:start --workspace=@geas/financeiro",
    "infra:stop": "npm run infra:stop --workspace=@geas/financeiro",
    "infra:status": "npm run infra:status --workspace=@geas/financeiro",
    "infra:reset": "npm run infra:reset --workspace=@geas/financeiro",
    "test:db": "npm run test:db --workspace=@geas/financeiro",
    "test:e2e": "npm run test:e2e --workspace=@geas/financeiro"
  },
  "engines": {
    "node": ">=22"
  }
}
