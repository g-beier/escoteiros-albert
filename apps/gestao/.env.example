# Desenvolvimento local: `npm run infra:start` gera `.env.local` e preserva GOOGLE_*, E2E_* e NEXT_PUBLIC_FEATURE_*.
# Não há produção ainda (ver db/README.md).

# Banco: o app conecta como geas_app; migrations e scripts, como o dono.
DATABASE_URL=postgres://geas_app:senha@127.0.0.1:54330/geas
DATABASE_ADMIN_URL=postgres://postgres:senha@127.0.0.1:54330/geas
# DATABASE_POOL_MAX=5

# Origem do app (redirect do Google e cookies Secure). Obrigatória fora do desenvolvimento.
APP_URL=http://localhost:3000

# Login com Google: cliente OAuth "Aplicativo da Web", redirect <APP_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Login sem Google, só em `next dev`:
# E2E_LOGIN=1

# Arquivos: local usa a connection string do Azurite (gerada); no Azure, a URL da conta + identidade gerenciada.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_URL=https://conta.blob.core.windows.net

# Site institucional, usado na configuração local
NEXT_PUBLIC_SITE_URL=http://localhost:4321

# Comprovantes dos lançamentos (envio e abertura de arquivos): desligados por enquanto. Ligar com "on".
# NEXT_PUBLIC_FEATURE_ATTACHMENTS=on
# Ramo Filhote (5 a 7 anos): o grupo ainda não tem. Ligar com "on".
# NEXT_PUBLIC_FEATURE_FILHOTES=on
