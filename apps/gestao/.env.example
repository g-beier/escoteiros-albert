# Produção/Preview: copie este arquivo e use as credenciais do projeto Supabase.
# Desenvolvimento local: `npm run infra:start` gera `.env.local` automaticamente.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel-ou-anon-key
SUPABASE_SECRET_KEY=sua-chave-secreta-ou-service-role-key-somente-no-servidor
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comprovantes dos lançamentos (envio e abertura de arquivos): desligados por enquanto. Ligar com "on".
# NEXT_PUBLIC_FEATURE_ATTACHMENTS=on
# Ramo Filhote (5 a 7 anos): o grupo ainda não tem. Ligar com "on".
# NEXT_PUBLIC_FEATURE_FILHOTES=on
