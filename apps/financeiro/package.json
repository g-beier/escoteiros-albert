{
  "name": "@geas/financeiro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "infra:start": "npx supabase start && npm run infra:env",
    "infra:stop": "npx supabase stop",
    "infra:status": "npx supabase status",
    "infra:reset": "npx supabase db reset && npm run infra:env",
    "infra:env": "node scripts/write-local-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
