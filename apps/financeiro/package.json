{
  "name": "@geas/financeiro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "infra:start": "npx supabase start && npm run infra:env",
    "infra:stop": "npx supabase stop",
    "infra:status": "npx supabase status",
    "infra:reset": "npx supabase db reset && npm run infra:env",
    "infra:env": "node scripts/write-local-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "npm exec --package=supabase -- supabase test db",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "@tabler/icons-react": "^3.51.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-virtual": "3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
